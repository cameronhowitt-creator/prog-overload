# Template — copy to .env.local and fill in. Never put real secrets in this file.

# Supabase — project URL + anon key (safe for browser) and service role (server only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DB_PASSWORD=

# Anthropic — server only. If unset, the app falls back to the mock program generator.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Storage backend: "local" (JSON file, default) or "supabase".
DATA_BACKEND=local

# Single-user dev mode: skip auth and scope everything to this user id.
# Set to any UUID for local dev; real auth takes over when Supabase auth is wired.
DEV_USER_ID=00000000-0000-0000-0000-000000000001
NEXT_PUBLIC_DEV_MODE=true
